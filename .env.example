# ─── Gemini AI Configuration ─────────────────
# 발급받은 API 키를 입력하세요 (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBED_MODEL=models/text-embedding-004
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_LITE_MODEL=gemini-2.5-flash-lite

# ─── Qdrant (Vector DB) ──────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=proposals_collection

# ─── PostgreSQL (Relational DB) ──────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=proposals_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
# 형식: postgresql://[user]:[password]@[host]:[port]/[db_name]
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/proposals_db

# ─── Redis (Caching/Session) ─────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ─── App Settings ────────────────────────────
APP_ENV=development
LOG_LEVEL=DEBUG
# 보안을 위해 무작위 문자열을 생성하여 사용하세요
SECRET_KEY=generate_a_secure_random_string_here
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000